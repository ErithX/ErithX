# Environment variable examples — DO NOT COMMIT SECRETS.
# Copy to .env.local or .env.production and fill values. .

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-public-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email provider (Resend/SendGrid)
EMAIL_PROVIDER=resend   # or sendgrid
RESEND_API_KEY=your-resend-api-key
SENDGRID_API_KEY=your-sendgrid-api-key

# App
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://erithx.dev

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX

# Upstash/QStash (if used)
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Notes:
# - Keep secret keys out of git.
# - SUPABASE_SERVICE_ROLE_KEY is highly privileged — never use in client code.
